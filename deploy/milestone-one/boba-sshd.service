[Unit]
Description=Boba dedicated MCP-over-SSH endpoint
After=network.target

[Service]
Type=simple
ExecStartPre=/usr/sbin/sshd -t -f /etc/boba/sshd_config
ExecStart=/usr/sbin/sshd -D -e -f /etc/boba/sshd_config
KillMode=control-group
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
